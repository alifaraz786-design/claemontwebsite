---
/**
 * Site footer: firm block on the left, three link columns on the right,
 * legal disclaimer beneath a hairline. Columns stack on mobile and the
 * dividing rules switch from vertical to horizontal.
 *
 * The disclaimer is set at the small step rather than micro — it is the text a
 * regulator would read, so it must stay legible on a phone.
 */
import { Image } from 'astro:assets';
import crest from '../assets/crest.png';
import Eyebrow from './ui/Eyebrow.astro';
import { site, footerColumns, legalDisclaimer, legalLinks } from '../data/site';
---

<footer class="gutter-x border-t border-hairline bg-ink pt-20 pb-10">
  <div class="grid gap-12 border-b border-hairline pb-16 lg:grid-split-5-7 lg:gap-6">
    <div class="flex flex-col gap-5 lg:pr-12">
      <Image src={crest} alt="" widths={[72, 144]} sizes="72px" class="h-18 w-18 object-contain object-left" />
      <div class="font-display text-xl font-medium uppercase tracking-wordmark">
        {site.name}
      </div>
      <p class="max-w-xs text-small text-ink-muted">
        Commercial Contracts &amp; Business Counsel · Remotely accessible
      </p>
    </div>

    <div class="grid gap-10 sm:grid-cols-3 lg:gap-0">
      {
        footerColumns.map((col) => (
          <div class="flex flex-col gap-3.5 border-t border-hairline pt-6 sm:border-t-0 sm:border-l sm:px-8 sm:pt-0">
            <Eyebrow class="mb-2">{col.title}</Eyebrow>
            {col.links.map((link) => (
              <a
                href={link.href}
                class="text-small text-ink-muted transition-colors duration-200 hover:text-ink-text"
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="flex flex-col gap-6 pt-6 sm:flex-row sm:justify-between sm:gap-12">
    <div class="flex max-w-4xl flex-col gap-3 text-small text-ink-muted">
      <p>© {site.name}. {legalDisclaimer[0]}</p>
      <p>{legalDisclaimer[1]}</p>
    </div>
    <!-- Set at the micro step: present in the corner where a reader expects
         it, without competing with anything else in the footer. -->
    <div class="flex shrink-0 gap-6 text-micro">
      {
        legalLinks.map((link) => (
          <a href={link.href} class="text-ink-muted transition-colors hover:text-ink-text">
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
