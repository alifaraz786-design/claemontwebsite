---
import Eyebrow from '../../ui/Eyebrow.astro';
import { whyJoin } from '../../../data/careers';
---

<section
  class="on-bone gutter-x section-y grid gap-8 bg-bone text-bone-text lg:grid-split-5-7 lg:gap-6"
>
  <div class="flex flex-col gap-6 lg:pr-18">
    <Eyebrow tone="bone">Working here</Eyebrow>
    <h2 class="text-h2-sm font-light lg:text-h2">
      What a young firm can offer that a large one cannot.
    </h2>
    <p class="text-body text-bone-muted">
      There is no hierarchy to climb before the work becomes real. Associates sit
      in on client meetings from the start, draft documents that go out under
      their own name, and are expected to have a view. The trade-off is honest:
      fewer people, longer days in busy weeks, and no department to hide inside.
    </p>
  </div>

  <div class="flex flex-col lg:border-l lg:border-bone-hairline lg:pl-24">
    {
      whyJoin.map((reason) => (
        <div class="grid grid-marker-sm gap-4 border-b border-bone-hairline py-7 lg:grid-marker-md lg:gap-6 lg:py-9">
          <div class="font-display text-h2 font-light leading-none text-gold-deep lg:text-h1">
            {reason.num}
          </div>
          <div class="flex flex-col gap-2.5">
            <h3 class="font-display text-h3-sm font-medium lg:text-h3">{reason.title}</h3>
            <p class="max-w-lg text-small text-bone-muted">{reason.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
