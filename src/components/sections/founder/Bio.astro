---
/**
 * The biography. The opening statement is set in the display face at the lead
 * step; the four paragraphs that follow are deliberately short so the section
 * stays readable at 390px. The closing quotation is Ali's own statement and is
 * attributed as such — it is not a historical quotation.
 */
import Eyebrow from '../../ui/Eyebrow.astro';
import Rule from '../../ui/Rule.astro';
import { founder, bio } from '../../../data/founder';
---

<section class="on-bone gutter-x section-y bg-bone text-bone-text">
  <div class="mx-auto flex max-w-measure flex-col gap-8 text-body lg:text-body-lg">
    <Eyebrow tone="bone">About</Eyebrow>

    <p class="font-display text-h3-sm font-normal lg:text-lead">{bio.opening}</p>

    {bio.paragraphs.map((para) => <p class="text-bone-muted">{para}</p>)}

    <figure class="flex flex-col gap-6 py-6">
      <Rule tone="bone" />
      <blockquote class="text-quote-sm font-light italic lg:text-h2">
        &ldquo;{founder.bioQuote}&rdquo;
      </blockquote>
      <figcaption class="text-small text-bone-muted">
        &mdash; {founder.fullName}
      </figcaption>
    </figure>
  </div>
</section>
