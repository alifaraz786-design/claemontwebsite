---
import SectionIntro from '../../ui/SectionIntro.astro';
import { credentials } from '../../../data/founder';
---

<section class="gutter-x section-y flex flex-col gap-10 lg:gap-16">
  <SectionIntro eyebrow="Credentials" heading="Qualifications and standing" />

  <div class="grid gap-10 lg:grid-cols-3 lg:gap-0">
    {
      credentials.map((group) => (
        <div class="flex flex-col gap-5 lg:border-l lg:border-hairline lg:px-10 lg:first:pl-0">
          <h3 class="border-b border-hairline pb-4 text-eyebrow font-medium uppercase tracking-eyebrow text-gold">
            {group.title}
          </h3>
          {group.items.map((item) => (
            <div class="flex flex-col gap-1">
              <div class="text-body text-ink-text">{item.main}</div>
              <div class="text-small text-ink-muted">{item.sub}</div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>
