---
/**
 * Career timeline on a gold spine. Restrained by design — this should read as
 * a list with a rule down it, not as an infographic.
 */
import Eyebrow from '../../ui/Eyebrow.astro';
import { timeline } from '../../../data/founder';
---

<section
  class="on-bone gutter-x section-y grid gap-8 bg-bone text-bone-text lg:grid-split-5-7 lg:gap-6"
>
  <div class="flex flex-col gap-4">
    <Eyebrow tone="bone">Experience</Eyebrow>
    <h2 class="max-w-sm text-h2-sm font-normal lg:text-h2">
      Where the experience comes from.
    </h2>
  </div>

  <ol class="relative flex flex-col pl-10 lg:pl-12">
    <div aria-hidden="true" class="absolute top-3 bottom-3 left-1.25 w-px bg-gold-deep"></div>
    {
      timeline.map((entry) => (
        <li class="relative grid gap-2 border-b border-bone-hairline py-7 lg:grid-marker-lg lg:gap-6">
          <div
            aria-hidden="true"
            class="marker-diamond absolute top-9 -left-10 h-2.75 w-2.75 border border-gold-deep bg-bone lg:-left-12"
          />
          <div class="font-display text-h3-sm font-normal text-gold-deep lg:text-h3">
            {entry.year}
          </div>
          <div class="flex flex-col gap-1.5">
            <h3 class="font-display text-h3-sm font-medium lg:text-h3">{entry.role}</h3>
            <p class="text-small text-bone-muted">{entry.line}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
