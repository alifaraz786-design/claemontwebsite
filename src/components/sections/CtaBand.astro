---
/**
 * The gold-ruled band that closes every page.
 *
 * The firm is remote and has no published telephone or office, so this carries
 * an email address, availability, and the button through to the intake form —
 * never a mailto for the primary action.
 */
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { contact } from '../../data/site';

interface Props {
  eyebrow?: string;
  heading?: string;
  body?: string;
  actionLabel?: string;
  actionHref?: string;
  class?: string;
}

const {
  eyebrow = 'Start a conversation',
  heading = 'Bring the agreement into focus.',
  body = 'If you need a contract drafted, reviewed, revised, or explained, send a brief description of the agreement and the assistance you are seeking. The firm will review the inquiry and update you.',
  actionLabel = 'Request a consultation',
  actionHref = '/contact',
  class: className = '',
}: Props = Astro.props;
---

<section class:list={['gutter-x pb-18 lg:pb-32', className]}>
  <div
    class="grid gap-10 border-y border-gold py-12 lg:grid-split-7-5 lg:gap-6 lg:py-20"
  >
    <div class="flex flex-col gap-5">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="text-h2-sm font-light lg:text-h1">{heading}</h2>
      <p class="max-w-xl text-body text-ink-muted lg:text-body-lg">{body}</p>
    </div>

    <div class="flex flex-col items-start gap-5 lg:justify-self-end">
      <Button href={actionHref}>{actionLabel}</Button>
      <div class="flex flex-col gap-1 text-small text-ink-muted">
        <a href={`mailto:${contact.email}`} class="transition-colors hover:text-ink-text">
          {contact.email}
        </a>
        <span>{contact.availability}</span>
      </div>
      <p class="max-w-sm text-micro text-ink-muted lg:text-small">
        Please do not send confidential information or documents with your
        initial inquiry. Contacting the firm does not establish a lawyer client
        relationship.
      </p>
    </div>
  </div>
</section>
