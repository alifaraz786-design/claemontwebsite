---
/**
 * "What you can hold us to" — three commitments.
 * Desktop: three columns divided by vertical rules.
 * Mobile:  stacked rows divided by horizontal rules, numeral beside the title.
 */
import SectionIntro from '../../ui/SectionIntro.astro';
import { commitments } from '../../../data/services';
---

<section
  id="why-this-firm"
  class="on-bone gutter-x section-y flex flex-col gap-10 bg-bone text-bone-text lg:gap-16"
>
  <SectionIntro
    tone="bone"
    eyebrow="Why this firm"
    heading="What you can hold us to."
    class="max-w-xl"
  />

  <div class="flex flex-col lg:grid lg:grid-cols-3">
    {
      commitments.map((item) => (
        <div
          class="grid grid-marker-sm gap-4 border-t border-bone-hairline py-7 lg:flex lg:flex-col lg:gap-5 lg:border-t-0 lg:border-l lg:px-10 lg:py-0 lg:first:pl-0"
        >
          <div class="font-display text-h2 font-light leading-none text-gold-deep lg:text-h1">
            {item.num}
          </div>
          <div class="flex flex-col gap-2.5">
            <h3 class="font-display text-h3-sm font-medium lg:text-h3">{item.title}</h3>
            <p class="text-small text-bone-muted">{item.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
