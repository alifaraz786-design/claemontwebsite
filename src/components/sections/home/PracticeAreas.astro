---
/**
 * Practice-area teaser grid. Four cards plus a dashed cell carrying the link
 * through to the full services page; on mobile the dashed cell is dropped and
 * the link stands on its own.
 */
import SectionIntro from '../../ui/SectionIntro.astro';
import Button from '../../ui/Button.astro';
import { services } from '../../../data/services';
---

<section id="practice-areas" class="gutter-x section-y flex flex-col gap-8 lg:gap-16">
  <SectionIntro
    eyebrow="Practice areas"
    heading="Two disciplines, one standard of care."
    blurb="Individuals facing charges and owner-managed businesses needing contracts done properly. The firm does not take on work outside these areas."
  />

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
    {
      services.map((service) => (
        <a
          href={`/services#${service.slug}`}
          class="group flex flex-col gap-3 border border-hairline p-6 text-ink-text transition-colors duration-250 hover:border-gold lg:min-h-70 lg:gap-4 lg:p-8"
        >
          <div class="text-eyebrow font-medium uppercase tracking-eyebrow text-gold">
            {service.num} · {service.audience}
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-display text-h3-sm font-medium lg:text-h3">{service.title}</h3>
            {/* Mobile: the arrow sits beside the title. */}
            <span aria-hidden="true" class="text-xl leading-none text-gold lg:hidden">
              →
            </span>
          </div>
          <p class="flex-1 text-small text-ink-muted">{service.teaser}</p>
          {/* Desktop: it drops to the foot of the card and slides on hover. */}
          <span
            aria-hidden="true"
            class="hidden text-xl leading-none text-gold transition-transform duration-250 group-hover:translate-x-2 lg:block"
          >
            →
          </span>
        </a>
      ))
    }

    <div
      class="hidden items-center justify-center border border-dashed border-hairline lg:flex lg:min-h-70 lg:col-span-2"
    >
      <Button href="/services" variant="text">All practice areas →</Button>
    </div>
  </div>

  <Button href="/services" variant="text" class="lg:hidden">All practice areas →</Button>
</section>
