---
import { Image } from 'astro:assets';
import heroImage from '../../../assets/hero-architecture.png';
import Button from '../../ui/Button.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
---

<section
  class="gutter-x grid gap-8 border-b border-gold pt-18 lg:min-h-204 lg:grid-split-7-5 lg:gap-6 lg:pt-0"
>
  <!-- Copy comes first in source order, so on mobile the heading and calls to
       action sit above the photograph without needing an order override. -->
  <div class="flex flex-col justify-center gap-6 lg:gap-8 lg:pr-18">
    <Eyebrow>Commercial contracts &amp; business counsel</Eyebrow>
    <h1 class="text-h2-sm font-light sm:text-h1 lg:text-hero">
      The agreements behind serious business.
    </h1>
    <p class="max-w-xl text-body text-ink-muted lg:text-body-lg">
      Claemont Ridge Law drafts, reviews, and refines commercial agreements for
      technology companies, established businesses, agencies, consultants, online
      enterprises, and independent professionals. Every engagement is handled
      directly by professionals, with close attention to the transaction, the
      relationship, and the risks that matter.
    </p>
    <!-- Side by side from sm up, aligned on the shared baseline of the two
         labels: the text link carries `self-start` for the stacked case, so it
         has to opt back in here. -->
    <div class="mt-2 flex flex-col items-start gap-6 sm:flex-row sm:items-baseline sm:gap-8">
      <Button href="/contact">Request a consultation</Button>
      <Button href="/services" variant="text" class="sm:self-baseline">
        Explore commercial services →
      </Button>
    </div>
  </div>

  <!-- Photography sits under an ink wash so gold stays the brightest thing here. -->
  <div class="relative mt-6 h-65 lg:mt-24 lg:mb-24 lg:h-auto">
    <Image
      src={heroImage}
      alt="The firm's offices"
      widths={[390, 780, 1100]}
      sizes="(min-width: 1024px) 34rem, 100vw"
      class="photo-treatment absolute inset-0 h-full w-full object-cover"
      loading="eager"
    />
    <div aria-hidden="true" class="absolute inset-0 bg-ink/55"></div>
    <Eyebrow class="absolute bottom-0 left-0 p-4 lg:p-6">
      Direct counsel · Clear terms
    </Eyebrow>
  </div>
</section>
