---
/**
 * Consultation intake form.
 *
 * Posts straight to Web3Forms — there is no backend and no client-side
 * submission handling, which is why this is a plain HTML form. On success
 * Web3Forms redirects to /thank-you, which carries the confirmation message.
 *
 * The form deliberately asks for a description rather than an upload: the firm
 * does not want confidential documents attached to a first enquiry.
 */
import Field from '../../ui/Field.astro';
import Button from '../../ui/Button.astro';
import Eyebrow from '../../ui/Eyebrow.astro';
import { web3FormsKey, site } from '../../../data/site';
import { needOptions, timingOptions } from '../../../data/intake';

const redirectUrl = new URL('/thank-you', Astro.site ?? site.url).href;
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="flex flex-col gap-11 lg:border-l lg:border-hairline lg:pl-24"
>
  <input type="hidden" name="access_key" value={web3FormsKey} />
  <input type="hidden" name="subject" value={`New consultation inquiry — ${site.name}`} />
  <input type="hidden" name="from_name" value={site.name} />
  <input type="hidden" name="redirect" value={redirectUrl} />

  <!-- Honeypot. Web3Forms discards any submission where this is filled in. -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
  />

  <div class="flex flex-col gap-4">
    <Eyebrow>Consultation inquiry</Eyebrow>
    <h2 class="text-h3-sm font-light lg:text-h2">Tell us about the agreement.</h2>
    <p class="max-w-xl text-body text-ink-muted">
      Provide enough information for an initial review of fit. Please do not
      upload confidential documents unless the firm requests them.
    </p>
  </div>

  <div class="grid gap-11 sm:grid-cols-2 sm:gap-x-8">
    <Field
      label="Name"
      name="name"
      required
      autocomplete="name"
      placeholder="Your full name"
    />
    <Field
      label="Email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="Your email address"
      error="Enter a complete email address."
    />
    <Field
      label="Company or organization"
      name="company"
      autocomplete="organization"
      placeholder="Optional"
      full
    />
    <Field
      label="Your location"
      name="location"
      required
      placeholder="Country and state, province, or region"
      full
    />
    <Field
      label="Other party's location"
      name="counterparty_location"
      placeholder="Country and state, province, or region, if known"
      full
    />
    <Field label="What do you need?" name="need" as="select" options={needOptions} required />
    <Field label="When is it needed?" name="timing" as="select" options={timingOptions} />
  </div>

  <Field
    label="Brief description"
    name="message"
    as="textarea"
    required
    rows={5}
    placeholder="Tell us what the agreement concerns, who the parties are, and whether a draft already exists."
  />

  <label class="grid grid-consent items-start gap-4">
    <input
      type="checkbox"
      name="acknowledgment"
      required
      class="mt-1 h-4.5 w-4.5 appearance-none rounded-none border border-gold bg-transparent checked:bg-gold"
    />
    <span class="text-small text-ink-muted">
      I understand that submitting this form does not create a lawyer client
      relationship and that I should not include confidential information.
    </span>
  </label>

  <Button type="submit" block={false}>Submit your inquiry</Button>
</form>
