---
/**
 * Office location.
 *
 * A drawn, monochrome placeholder rather than an embedded map: a default
 * Google Maps iframe is full colour, breaks the palette, and drops third-party
 * cookies on a page that promises confidentiality. Swap in a styled static map
 * image (or a consented embed) once the real address is known.
 */
import Eyebrow from '../../ui/Eyebrow.astro';
import { contact, site } from '../../../data/site';
---

<section
  class="on-bone relative h-90 overflow-hidden border-t border-bone-hairline bg-bone text-bone-text lg:h-105"
  aria-label="Office location"
>
  <div aria-hidden="true" class="map-grid absolute inset-0"></div>
  <div aria-hidden="true" class="map-roads absolute inset-0 opacity-90"></div>

  <div
    aria-hidden="true"
    class="absolute top-1/2 left-1/2 flex -translate-x-1/2 -translate-y-full flex-col items-center"
  >
    <div class="marker-diamond h-3.5 w-3.5 border border-gold-deep bg-bone"></div>
    <div class="h-7 w-px bg-gold-deep"></div>
  </div>

  <div
    class="absolute top-1/2 left-1/2 flex min-w-70 -translate-x-1/2 translate-y-4 flex-col gap-1 bg-ink px-6 py-4"
  >
    <Eyebrow>{site.name}</Eyebrow>
    <p class="text-small text-ink-text">
      {contact.addressLines[0]}, {site.region}
    </p>
    <a
      href={contact.directionsUrl}
      class="mt-1.5 text-micro uppercase tracking-nav text-ink-muted transition-colors hover:text-ink-text"
    >
      Open in Maps →
    </a>
  </div>
</section>
