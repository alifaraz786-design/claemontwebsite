---
/**
 * Underline-only form field — no boxes anywhere in this system.
 *
 * Validation is left to the browser: `:user-invalid` styles the error state
 * only after the visitor has actually interacted with the field, which is why
 * there is no JavaScript here.
 *
 * `tone` follows the ground the form sits on: the client inquiry is on ink,
 * the career inquiry on bone.
 */
interface Props {
  label: string;
  name: string;
  as?: 'input' | 'textarea' | 'select';
  type?: 'text' | 'email' | 'tel' | 'url';
  tone?: 'ink' | 'bone';
  required?: boolean;
  autocomplete?: string;
  placeholder?: string;
  rows?: number;
  /** Select options. The first is rendered as the empty prompt. */
  options?: readonly string[];
  /** Message shown when the browser marks the field invalid. */
  error?: string;
  /** Span both columns in the two-up grid. */
  full?: boolean;
  class?: string;
}

const {
  label,
  name,
  as = 'input',
  type = 'text',
  tone = 'ink',
  required = false,
  autocomplete,
  placeholder,
  rows = 4,
  options,
  error,
  full = false,
  class: className = '',
}: Props = Astro.props;

const errorId = error ? `${name}-error` : undefined;

const surface = {
  ink: 'border-hairline text-ink-text focus:border-gold focus:shadow-field',
  bone: 'border-bone-hairline text-bone-text focus:border-gold-deep focus:shadow-field-bone',
}[tone];

const labelTone = tone === 'ink' ? 'text-ink-muted' : 'text-bone-muted';
const caret = tone === 'ink' ? 'border-gold' : 'border-gold-deep';

const control = [
  'w-full rounded-none border-0 border-b bg-transparent',
  'px-0 pt-2.5 pb-3.5 font-sans text-body',
  'transition-colors duration-200',
  'placeholder:text-bone-muted',
  'focus:outline-none',
  'user-invalid:border-error',
  surface,
].join(' ');
---

<label class:list={['flex flex-col gap-3', full && 'sm:col-span-2', className]}>
  <span class:list={['text-eyebrow font-medium uppercase tracking-eyebrow', labelTone]}>
    {label}{required && <span class="sr-only"> (required)</span>}
  </span>

  {
    as === 'textarea' ? (
      <textarea
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        aria-describedby={errorId}
        class:list={[control, 'resize-y leading-relaxed']}
      />
    ) : as === 'select' ? (
      <span class="relative flex">
        <select
          name={name}
          required={required}
          aria-describedby={errorId}
          class:list={[control, 'cursor-pointer appearance-none pr-8']}
        >
          <option value="">Select one</option>
          {options?.map((option) => <option value={option}>{option}</option>)}
        </select>
        <span
          aria-hidden="true"
          class:list={[
            'pointer-events-none absolute top-3.5 right-1 h-2 w-2 rotate-45 border-r border-b',
            caret,
          ]}
        />
      </span>
    ) : (
      <input
        type={type}
        name={name}
        required={required}
        autocomplete={autocomplete}
        placeholder={placeholder}
        aria-describedby={errorId}
        class={control}
      />
    )
  }

  {
    error && (
      <span id={errorId} class="field-error items-baseline gap-2 text-micro text-error-text">
        <span aria-hidden="true" class="text-error">
          —
        </span>
        {error}
      </span>
    )
  }
</label>
