---
/**
 * Privacy, Terms and Legal Notice — one page, one notice.
 *
 * Deliberately understated at the client's request: no page header, no hero
 * type, body set at the micro step, reached only from the footer. It is
 * indexable and readable, but it is not part of the sales path.
 */
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { site } from '../data/site';
import { legalNotice } from '../data/legal';
---

<Layout
  title="Privacy, Terms & Legal Notice"
  description="Privacy, terms and legal notice for Claemont Ridge Law."
>
  <section id="legal" class="gutter-x section-y">
    <div class="flex max-w-measure flex-col gap-6">
      <Eyebrow>Privacy · Terms · Legal Notice</Eyebrow>
      <h1 class="text-h3-sm font-light lg:text-h3">
        Privacy, Terms and Legal Notice
      </h1>
      {legalNotice.map((para) => <p class="text-micro text-ink-muted">{para}</p>)}
      <p class="text-micro text-ink-muted">© {site.name}</p>
    </div>
  </section>
</Layout>
