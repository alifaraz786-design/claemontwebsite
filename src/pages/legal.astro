---
/**
 * Privacy, Terms and Legal Notice resolve here — one page, three anchors, as
 * instructed. The notice text is the client's; the privacy and terms sections
 * are structured placeholders awaiting their copy.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import { site, contact, legalDisclaimer } from '../data/site';
---

<Layout
  title="Legal Notice"
  description="Legal notice, privacy and terms for Claemont Ridge Law."
>
  <PageHeader
    eyebrow="Legal"
    heading="Legal notice, privacy, and terms."
    blurb="One page covering how this website may be used, what it does and does not establish, and how information sent to the firm is handled."
  />

  <section class="on-bone gutter-x section-y bg-bone text-bone-text">
    <div class="mx-auto flex max-w-measure flex-col gap-14">
      <div id="legal-notice" class="flex flex-col gap-5 scroll-mt-24">
        <Eyebrow tone="bone">Legal notice</Eyebrow>
        <h2 class="text-h3-sm font-normal lg:text-h3">No legal advice, no relationship</h2>
        {legalDisclaimer.map((para) => <p class="text-body">{para}</p>)}
      </div>

      <div id="privacy" class="flex flex-col gap-5 border-t border-bone-hairline pt-14 scroll-mt-24">
        <Eyebrow tone="bone">Privacy</Eyebrow>
        <h2 class="text-h3-sm font-normal lg:text-h3">What the firm collects</h2>
        <p class="text-body">
          This website collects nothing on its own. It sets no analytics or
          advertising cookies and stores nothing in your browser.
        </p>
        <p class="text-body text-bone-muted">
          If you submit the consultation inquiry form, the details you enter are
          delivered to the firm by email through a third-party form service. They
          are used only to respond to your inquiry and to assess whether the firm
          can act. Write to <a href={`mailto:${contact.email}`} class="border-b border-gold-deep">{contact.email}</a> to ask
          what is held or to have it deleted.
        </p>
        <p class="text-body text-bone-muted">
          [PLACEHOLDER — confirm with the firm: retention period, the named form
          provider, and the lawful basis or privacy statute relied on in the
          jurisdictions the firm serves.]
        </p>
      </div>

      <div id="terms" class="flex flex-col gap-5 border-t border-bone-hairline pt-14 scroll-mt-24">
        <Eyebrow tone="bone">Terms</Eyebrow>
        <h2 class="text-h3-sm font-normal lg:text-h3">Using this website</h2>
        <p class="text-body">
          The content of this website is the property of {site.name} and is
          provided for general information. It may be read and shared, but not
          reproduced as your own or presented as legal advice to another party.
        </p>
        <p class="text-body text-bone-muted">
          [PLACEHOLDER — confirm with the firm: governing law, limitation of
          liability, and any terms specific to the jurisdictions in which the
          firm is authorized to practise.]
        </p>
      </div>
    </div>
  </section>
</Layout>
