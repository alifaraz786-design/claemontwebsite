---
/**
 * Web3Forms redirects here after a client inquiry. Not indexed — it is a
 * confirmation, not a page anyone should land on from search.
 */
import Layout from '../layouts/Layout.astro';
import Confirmation from '../components/sections/Confirmation.astro';
import { contact } from '../data/site';
---

<Layout
  title="Inquiry received"
  description="Your inquiry has reached Claemont Ridge Law."
  indexable={false}
>
  <Confirmation
    eyebrow="Inquiry received"
    heading="Your inquiry has been received for an initial review."
  >
    <p>
      Claemont Ridge Law has not accepted the matter or assumed responsibility
      for any deadline unless and until an engagement is confirmed in writing.
    </p>
    <p>
      The firm will review what you have sent and update you by email at{' '}
      <a
        href={`mailto:${contact.email}`}
        class="border-b border-gold text-ink-text transition-colors hover:text-gold"
        >{contact.email}</a
      >.
    </p>
  </Confirmation>
</Layout>
