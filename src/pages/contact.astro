---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ContactDetails from '../components/sections/contact/ContactDetails.astro';
import EnquiryForm from '../components/sections/contact/EnquiryForm.astro';
import CareersPanel from '../components/sections/contact/CareersPanel.astro';
import FormScript from '../components/sections/contact/FormScript.astro';
---

<Layout
  title="Contact"
  description="Start a conversation with Claemont Ridge Law about a commercial agreement. Send a brief description of the agreement and the assistance you are seeking."
>
  <PageHeader
    eyebrow="Contact"
    heading="Bring the agreement into focus."
    blurb="If you need a contract drafted, reviewed, revised, or explained, send a brief description of the agreement and the assistance you are seeking. The firm will review the inquiry and update you."
  />

  <section class="gutter-x section-y grid gap-12 lg:grid-split-5-7 lg:items-start lg:gap-6">
    <ContactDetails />
    <EnquiryForm />
  </section>

  <CareersPanel />

  <FormScript />
</Layout>
