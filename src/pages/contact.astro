---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ContactDetails from '../components/sections/contact/ContactDetails.astro';
import EnquiryForm from '../components/sections/contact/EnquiryForm.astro';
import MapPanel from '../components/sections/contact/MapPanel.astro';
---

<Layout
  title="Contact"
  description="Speak to Claemont Ridge Law about a commercial agreement. Your enquiry reaches the lawyer who will handle the matter."
>
  <PageHeader
    eyebrow="Contact"
    heading="Speak to the firm."
    blurb="Your enquiry reaches the lawyer who will handle the matter, not an intake team."
  />

  <section class="gutter-x section-y grid gap-12 lg:grid-split-5-7 lg:items-start lg:gap-6">
    <ContactDetails />
    <EnquiryForm />
  </section>

  <MapPanel />
</Layout>
