---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import ServiceBlock from '../components/sections/services/ServiceBlock.astro';
import Process from '../components/sections/services/Process.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { services } from '../data/services';

---

<Layout
  title="Commercial Services"
  description="Commercial agreements, technology contracts, digital terms and policies, and work and employment agreements, drafted and reviewed for businesses and professionals."
>
  <PageHeader
    eyebrow="Commercial contracts & business counsel"
    heading="Agreements made for the way business works."
    blurb="Claemont Ridge Law drafts, reviews, and refines the agreements through which businesses sell, buy, build, hire, collaborate, and protect what they have created. The firm works directly with founders, companies, agencies, online businesses, independent professionals, and individuals entering important commercial or employment relationships."
  />

  {services.map((service) => <ServiceBlock service={service} />)}

  <Process />
  <CtaBand class="pt-18 lg:pt-32" />
</Layout>
