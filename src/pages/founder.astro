---
import Layout from '../layouts/Layout.astro';
import FounderHero from '../components/sections/founder/FounderHero.astro';
import Bio from '../components/sections/founder/Bio.astro';
import Credentials from '../components/sections/founder/Credentials.astro';
import Experience from '../components/sections/founder/Experience.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { founder } from '../data/founder';
---

<Layout
  title="Founder"
  description={`${founder.fullName}, ${founder.title} at Claemont Ridge Law. Commercial contracts and business counsel.`}
>
  <FounderHero />
  <Bio />
  <Credentials />
  <Experience />
  <CtaBand
    class="pt-18 lg:pt-32"
    eyebrow="Start a conversation"
    heading={`Work directly with ${founder.firstName}`}
    body="Send a brief description of the agreement and the assistance you are seeking. The firm will review the inquiry and update you."
  />
</Layout>
